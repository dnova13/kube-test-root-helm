# 이 파일을 terraform.tfvars로 복사해서 쓴다 (terraform.tfvars는 git에 올리지 않는다)
#   cp terraform.tfvars.example terraform.tfvars
# 비밀번호는 여기 쓰지 말고 환경변수로 넘긴다:
#   export TF_VAR_db_password='...'

# 기존 스택(sns-db 등)이 살아 있는 동안 나란히 시험할 때만 바꾼다. 기존 스택을 지운 뒤에는 기본값 sns
# name = "sns-tf"

# 노드 수 (현재 클러스터는 실험으로 6대, 기본은 3대)
# node_desired_size = 3

# 내 PC에서 RDS 3306에 직접 접속하려면 내 공인 IP를 적는다 (RDS는 비공개라 열어도 안 될 수 있음)
# admin_cidr = "1.2.3.4/32"

# 데이터를 살리려면 복원할 RDS 스냅샷 이름 (AWS를 내리기 전에 스냅샷을 만들어 둔다)
# db_snapshot_identifier = "sns-db-before-teardown"
